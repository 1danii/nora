// The Worker for apps/web. Vite builds it into apps/web/dist/server/wrangler.json,
// and that generated file is what `bun run deploy` ships.
{
  "$schema": "./apps/web/node_modules/wrangler/config-schema.json",
  "name": "nora",
  "main": "./apps/web/src/server.ts",
  "compatibility_date": "2026-10-26",
  // process.env and the node:* modules that Effect and varlock use.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // IBKR_LOGIN_MODE is set per deployment, never here: a var in this file
  // would overwrite the deployment's own on every deploy. keep_vars keeps the
  // vars set on the Worker (dashboard or `--var`). Unset means demo.
  // - private: real IBKR login for IBKR_ALLOWED_USERNAME, so the Worker must
  //   sit behind Cloudflare Access (Settings → Domains & Routes → Cloudflare
  //   Access, all traffic). Without it every request gets a 403.
  // - demo: only the demo account. For public deployments.
  "keep_vars": true,
}
