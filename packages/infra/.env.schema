# Emails Cloudflare Access lets through to the app, comma-separated. Empty:
# no Access, the app is public. Required in private mode, so real IBKR
# logins are never deployed without Access in front of them.
# @required=eq($IBKR_LOGIN_MODE, private) @sensitive=false
# @type=array(email(normalize=true), unique=true)
ACCESS_EMAILS=
