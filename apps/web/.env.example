# Copy to .env and fill in the required values below. For local dev only:
# deployed Workers use their own vars and secrets (see wrangler.jsonc).

# demo (default): only the demo account, nothing else to set. private: real
# IBKR login for IBKR_ALLOWED_USERNAME. Deployed, private mode needs
# Cloudflare Access in front of the Worker; local dev skips that check.
# IBKR_LOGIN_MODE=private

# Required in private mode: your IBKR username.
# IBKR_ALLOWED_USERNAME=

# Required in private mode: encrypts the login cookie.
#   openssl rand -base64 48
# SESSION_SECRET=
