# Copy to .env and fill in the required values below.

# Encrypts the login cookie.
#   openssl rand -base64 48
SESSION_SECRET=

# demo (default): public, only the demo account. private: real IBKR login
# for IBKR_ALLOWED_USERNAME, deployed behind Cloudflare Access.
# IBKR_LOGIN_MODE=private

# Required in private mode: your IBKR username.
# IBKR_ALLOWED_USERNAME=

# Private mode also needs ACCESS_EMAILS (who Cloudflare Access lets in) in
# packages/infra/.env, or deploys fail.

# The app's public URL, without a trailing slash. Defaults to localhost for
# dev; set it to the deployed URL, or every login is refused there.
# APP_ORIGIN=https://nora.example.com
