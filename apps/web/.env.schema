# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# The public web origin. POSTs to /api must come from it.
# @type=url
APP_ORIGIN=http://localhost:3000

# Encrypts the IBKR session cookie. Rotating it signs everyone out.
# @type=string(minLength=32)
SESSION_SECRET=

# The only IBKR username allowed to use the browser login (/api/ibkr/start).
# Login is refused while this is empty.
# @optional @type=string(minLength=1)
IBKR_ALLOWED_USERNAME=

# Unused for now; packages/db reads it for Drizzle commands.
# @optional @type=string(minLength=1)
DATABASE_URL=
