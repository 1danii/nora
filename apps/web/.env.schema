# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# Encrypts the IBKR session cookie. Rotating it signs everyone out. Private
# mode only: a demo session holds no IBKR cookies, so it isn't encrypted.
# @required=eq($IBKR_LOGIN_MODE, private) @type=string(minLength=32)
SESSION_SECRET=

# Who can log in with a real IBKR account.
# - demo: nobody. The login page only offers the demo account. For public deployments.
# - private: only IBKR_ALLOWED_USERNAME. Deployed, every request must come
#   through Cloudflare Access or it gets a 403.
# @public @type=enum(demo, private)
IBKR_LOGIN_MODE=demo

# The only IBKR username that can log in (/api/ibkr/start). Private mode only.
# @required=eq($IBKR_LOGIN_MODE, private) @type=string(minLength=1)
IBKR_ALLOWED_USERNAME=
