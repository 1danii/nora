{
  "name": "nora",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "typescript": "^6.0.3",
      "@types/bun": "^1.4.5",
      "varlock": "1.25.0",
      "react": "^19.3.1",
      "react-dom": "^19.3.1",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "drizzle-orm": "1.0.0-rc.6",
      "effect": "4.1.5",
      "@effect/platform-bun": "4.1.5",
      "@effect/sql-pg": "4.1.5"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web --",
    "db:push": "turbo run db:push -F @nora/db --",
    "db:studio": "turbo run db:studio -F @nora/db --",
    "db:generate": "turbo run db:generate -F @nora/db --",
    "db:migrate": "turbo run db:migrate -F @nora/db --",
    "deploy": "cd apps/web && bun run deploy",
    "env:generate": "varlock codegen --path ./apps/web/",
    "postinstall": "varlock codegen --path ./apps/web/",
    "check": "ultracite check",
    "test": "vitest run",
    "fix": "ultracite fix"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261123.1",
    "@nora/config": "workspace:*",
    "@stylexjs/eslint-plugin": "^0.19.2",
    "@types/bun": "catalog:",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "turbo": "^2.11.13",
    "typescript": "catalog:",
    "ultracite": "7.12.0",
    "varlock": "catalog:",
    "vitest": "5.1.1"
  },
  "packageManager": "bun@1.4.2",
  "cloudflare": {
    "bindings": {
      "IBKR_LOGIN_MODE": {
        "description": "Keep **private** to log in with your own IBKR account. After deploying, turn on Cloudflare Access for this Worker (**Settings → Domains & Routes → Cloudflare Access**, then **All traffic**) so only you can open it. The site stays locked until you do. Choose **demo** instead for a public site that only shows a sample account."
      },
      "IBKR_ALLOWED_USERNAME": {
        "description": "Your IBKR username. Only this account can log in."
      },
      "SESSION_SECRET": {
        "description": "A random string of at least 32 characters. Create one with `openssl rand -base64 48`, or use any password generator."
      }
    }
  }
}
