{
  "name": "nora",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "typescript": "^6.0.3",
      "@types/bun": "^1.4.5",
      "varlock": "1.25.0",
      "react": "^19.3.1",
      "react-dom": "^19.3.1",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "drizzle-orm": "1.0.0-rc.6",
      "effect": "4.1.5",
      "@effect/platform-bun": "4.1.5",
      "@effect/sql-pg": "4.1.5"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web --",
    "dev:infra": "turbo run dev:infra -F @nora/infra --",
    "db:push": "turbo run db:push -F @nora/db --",
    "db:studio": "turbo run db:studio -F @nora/db --",
    "db:generate": "turbo run db:generate -F @nora/db --",
    "db:migrate": "turbo run db:migrate -F @nora/db --",
    "deploy": "turbo run deploy -F @nora/infra --",
    "destroy": "turbo run destroy -F @nora/infra --",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/",
    "check": "ultracite check",
    "test": "vitest run",
    "fix": "ultracite fix"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261123.1",
    "@nora/config": "workspace:*",
    "@stylexjs/eslint-plugin": "^0.19.2",
    "@types/bun": "catalog:",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "turbo": "^2.11.13",
    "typescript": "catalog:",
    "ultracite": "7.12.0",
    "varlock": "catalog:",
    "vitest": "5.1.1"
  },
  "packageManager": "bun@1.4.2"
}
